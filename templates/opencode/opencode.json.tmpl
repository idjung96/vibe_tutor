{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "dev-agent-team/PROJECT_RULES.md"],
  "permission": {
    "bash": {
      "*": "allow",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push --force-with-lease*": "deny",
      "git push*--force*": "deny",
      "rm -rf*": "deny",
      "rm -r *": "deny",
      "git reset --hard*": "deny",
      "git branch -D*": "deny",
      "python -c*": "deny",
      "python3 -c*": "deny",
      "node -e*": "deny",
      "node --eval*": "deny",
      "curl*": "deny",
      "wget*": "deny"
    }
  }
}

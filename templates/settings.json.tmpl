{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read", "Write", "Edit",
      "Bash(pytest:*)",
      "Bash(python:*)", "Bash(python3:*)",
      "Bash(pip install:*)", "Bash(pip3 install:*)", "Bash(uv add:*)",
      "Bash(go:*)", "Bash(cargo:*)",
      "Bash(npm:*)", "Bash(npx:*)", "Bash(node:*)", "Bash(pnpm:*)", "Bash(yarn:*)",
      "Bash(mkdir:*)", "Bash(ls:*)", "Bash(cat:*)", "Bash(grep:*)",
      "Bash(find:*)", "Bash(mv:*)", "Bash(touch:*)", "Bash(head:*)", "Bash(tail:*)",
      "Bash(git checkout:*)", "Bash(git add:*)", "Bash(git commit:*)",
      "Bash(git merge:*)", "Bash(git status)", "Bash(git diff:*)",
      "Bash(git log:*)", "Bash(git branch)",
      "WebFetch(domain:pypi.org)",
      "WebFetch(domain:readthedocs.io)",
      "WebFetch(domain:*.readthedocs.io)",
      "WebFetch(domain:docs.python.org)",
      "WebFetch(domain:www.npmjs.com)",
      "WebSearch"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(rm -rf:*)", "Bash(rm -r:*)",
      "Bash(git reset --hard:*)",
      "Bash(git branch -D:*)",
      "Bash(python -c:*)", "Bash(python3 -c:*)",
      "Bash(node -e:*)", "Bash(node --eval:*)",
      "Bash(curl:*)", "Bash(wget:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/dev-agent-team/hooks/block_on_owner_question.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/dev-agent-team/hooks/protect_tests.sh"
          }
        ]
      }
    ]
  }
}
